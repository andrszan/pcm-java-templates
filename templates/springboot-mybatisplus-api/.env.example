# 复制为 .env；Spring Boot 从项目根按 UTF-8 Java properties 自动读取。
# 本文件不是 shell 脚本：不要添加 export，也不要为值添加 shell 引号。
# 环境变量、JVM 系统属性和命令行参数仍可覆盖这里的本地开发值。

# MySQL
DB_PROTOCOL=jdbc:mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=<请替换为项目数据库密码>
DB_NAME=app_dev
TEST_DB_NAME=app_test

# PostgreSQL（二选一时注释上方 MySQL 配置并启用这一组）
# DB_PROTOCOL=jdbc:postgresql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=app_user
# DB_PASSWORD=<请替换为项目数据库密码>
# DB_NAME=app_dev
# TEST_DB_NAME=app_test
