# 按派生项目选定的数据库填写一组，MySQL 和 PostgreSQL 二选一。
# Spring Boot 不自动读取 .env：运行前执行 set -a; source .env; set +a

# MySQL（默认协议，无需设置 DB_PROTOCOL）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<本地开发密码>
DB_NAME=app_dev
TEST_DB_NAME=app_test

# PostgreSQL（额外设置协议与端口）
# DB_PROTOCOL=jdbc:postgresql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=zhou
# DB_PASSWORD=<本地开发密码>
# DB_NAME=app_dev
# TEST_DB_NAME=app_test
